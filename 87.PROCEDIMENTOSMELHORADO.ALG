Algoritmo "87.PROCEDIMENTOSMELHORADO"
Var
    m:caractere
Procedimento Gerador (mens:caractere)
Inicio
      escreval("===============")
      escreval(mens)
      escreval("===============")
Fimprocedimento
Inicio
      escreval("Digite uma mensagem: ")
      leia(m)
      Gerador(m)
Fimalgoritmo
