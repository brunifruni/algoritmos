Algoritmo "90.PROCEDIMENTOSOMADOR"
Var
n1, n2, soma: inteiro
Procedimento Somador (var x,y:inteiro)
inicio
      x <- n1
      y <- n2
      escreval("A soma dos valores é igual a ", x + y)
fimprocedimento
Inicio
       escreval("Digite um número: ")
       leia(n1)
       escreval("Digite outro número: ")
       leia (n2)
       Somador (n1,n2)
Fimalgoritmo